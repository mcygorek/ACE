te    20.48
dt     0.04
threshold    1e-8
threshold_range_factor 1
use_Gaussian true
set_precision 12

Boson_J_type ohmic 
Boson_J_s         1
Boson_J_div_by_cutoff true
Boson_J_alpha  {2*0.1}
Boson_J_omega_c    5
Boson_J_cutoff   exp 
Boson_omega_max  100
#Boson_J_print  J.dat  0 100 10000
Boson_SysOp  {0.5*sigma_z}

initial {|1><1|_2}
add_Hamiltonian {hbar/2* 1 * sigma_x}
add_Output {sigma_z}


outfile  ohmic_alpha0.1_te20.48_dt0.04_thr1e-8.out

